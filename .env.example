# =============================================================================
# LiteLLM + LlamaStack Demo Configuration
# =============================================================================
#
# This file shows all available environment variables for configuring the
# demos. Copy this file to .env and customize the values for your environment.
#
# IMPORTANT: Never commit .env files to git (they may contain sensitive data)
#

# =============================================================================
# REQUIRED: API Endpoints
# =============================================================================

# LiteLLM API endpoint - get from OpenShift route
# Command: oc get route litellm -n <namespace> -o jsonpath='{.spec.host}'
LITELLM_BASE_URL=https://litellm-your-namespace.apps.your-cluster.domain.com

# LlamaStack API endpoint - get from OpenShift route
# Command: oc get route llamastack -n <namespace> -o jsonpath='{.spec.host}'
LLAMASTACK_BASE_URL=https://llamastack-your-namespace.apps.your-cluster.domain.com

# =============================================================================
# REQUIRED: Authentication
# =============================================================================

# LiteLLM Master Key - used for admin operations (creating API keys, etc.)
# This is the value you set in deploy/helm/values.yaml under litellm.masterKey
LITELLM_MASTER_KEY=your-secure-master-key

# LiteLLM API Key - used for model requests
# Create this via the LiteLLM admin UI or use the master key for demos
LITELLM_API_KEY=sk-your-api-key-here

# =============================================================================
# OPTIONAL: Kubernetes Configuration
# =============================================================================

# Kubernetes namespace where LiteLLM is deployed
# Default: litellm
LITELLM_NAMESPACE=litellm

# Kubernetes namespace where LLM-D integration is deployed
# Default: llmd
LLMD_NAMESPACE=llmd

# =============================================================================
# OPTIONAL: Model Configuration
# =============================================================================

# Default model name for LiteLLM demos
# Common values: llama3, llama-fp8, openai/llama-fp8
DEFAULT_LITELLM_MODEL=llama3

# Default model name for LlamaStack demos
# Format: litellm-provider/model-name
DEFAULT_LLAMASTACK_MODEL=litellm-provider/llama3

# =============================================================================
# OPTIONAL: Internal Service Configuration (for in-cluster usage)
# =============================================================================

# Custom service host for LLaMA FP8 model (if different from default)
# Default: http://llama-fp8-service:8080
LLAMA_FP8_SERVICE_HOST=http://llama-fp8-predictor.your-namespace.svc.cluster.local:8080

# =============================================================================
# DEVELOPMENT: Local Testing
# =============================================================================

# For local development with port-forwarding:
# oc port-forward svc/litellm 4000:4000 -n <namespace>
# oc port-forward svc/llamastack 8001:8001 -n <namespace>
#
# Then use:
# LITELLM_BASE_URL=http://localhost:4000
# LLAMASTACK_BASE_URL=http://localhost:8001

# =============================================================================
# Usage Examples
# =============================================================================

# Example 1: Basic demo usage
# LITELLM_BASE_URL=https://litellm-demo.apps.cluster.local python demos/budget_test.py

# Example 2: Production configuration
# export LITELLM_BASE_URL=https://litellm-prod.apps.cluster.local
# export LITELLM_MASTER_KEY=prod-secure-key
# python demos/guardrails_demo.py

# Example 3: Testing configuration
# python demos/config.py  # Shows current config and validation warnings

# Example 4: Override namespace for shell scripts
# ./deploy/install.sh custom-namespace

# =============================================================================
# Getting Your Values
# =============================================================================

# 1. Find your LiteLLM route:
#    oc get route litellm -n <namespace> -o jsonpath='{.spec.host}'
#    Then use: https://<host>

# 2. Find your LlamaStack route:
#    oc get route llamastack -n <namespace> -o jsonpath='{.spec.host}'
#    Then use: https://<host>

# 3. Get your master key from Helm values:
#    Look in deploy/helm/values.yaml under litellm.masterKey

# 4. Create API keys via LiteLLM admin UI:
#    Navigate to https://<litellm-host>/ui
#    Login with admin/<master-key>
#    Go to "Virtual Keys" → "Create Key"

# 5. Test your configuration:
#    python demos/config.py
#    python demos/budget_test.py